---
import { STORE_CONFIG } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';

const defaultMessage = "¡Hola! Me gustaría hacer una consulta sobre la parafernalia 420 en Perú.";
const whatsappUrl = `https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<aside class="whatsapp-float-container" aria-label="Contacto por WhatsApp">
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-fab-btn"
    title="Chatear por WhatsApp"
    id="whatsapp-floating-btn"
    aria-label="Atención al cliente por WhatsApp"
  >
    <div class="whatsapp-icon-inner">
      <WhatsAppIcon size={28} fill="#FFFFFF" />
    </div>
    <span class="whatsapp-fab-label hide-mobile">¿Dudas? Chatea aquí</span>
  </a>
</aside>

<style>
  .whatsapp-float-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 99999;
    pointer-events: auto;
  }

  .whatsapp-fab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    background-color: #0B120D;
    border: 1.5px solid #22C55E;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.85), 0 0 16px rgba(34, 197, 94, 0.3);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .whatsapp-fab-btn:hover {
    transform: translateY(-3px) scale(1.05);
    background-color: #121F16;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.9), 0 0 24px rgba(34, 197, 94, 0.5);
  }

  .whatsapp-icon-inner {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: #22C55E;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-fab-label {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: #FFFFFF;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .whatsapp-float-container {
      bottom: 1.25rem;
      right: 1.25rem;
    }

    .hide-mobile {
      display: none !important;
    }

    .whatsapp-fab-btn {
      padding: 0;
      background: transparent;
      border: none;
      box-shadow: none;
      width: 52px;
      height: 52px;
    }

    .whatsapp-icon-inner {
      width: 52px;
      height: 52px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.85), 0 0 20px rgba(34, 197, 94, 0.4);
    }
  }
</style>
