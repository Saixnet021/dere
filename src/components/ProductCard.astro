---
import type { Product } from '../data/products';
import { formatPrice, STORE_CONFIG } from '../config';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="product-card" data-product-id={product.id}>
  <!-- Imagen del Producto con Fallback de Seguridad -->
  <a href={`/producto/${product.slug}`} class="product-image-wrap" aria-label={product.name}>
    <img 
      src={product.image} 
      alt={product.name} 
      class="product-image" 
      loading="lazy" 
      decoding="async"
      width="300"
      height="300"
      onerror="this.src='/images/hero-banner.jpg'"
    />
  </a>

  <!-- Información del Producto -->
  <div class="product-info">
    <div class="product-meta">
      <span class="product-category">{product.categoryName}</span>
      <div class="product-rating" aria-label={`Calificación: ${product.rating} estrellas`}>
        <svg class="icon-outline star-icon" viewBox="0 0 24 24" width="13" height="13">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>{product.rating.toFixed(1)}</span>
      </div>
    </div>

    <h3 class="product-title">
      <a href={`/producto/${product.slug}`}>{product.name}</a>
    </h3>

    <p class="product-short-desc">{product.shortDescription}</p>

    <!-- Precios y Botón de Acción -->
    <div class="product-bottom">
      <div class="product-pricing">
        <span class="product-price">{formatPrice(product.price)}</span>
        {product.originalPrice && (
          <span class="product-original-price">{formatPrice(product.originalPrice)}</span>
        )}
      </div>

      <button 
        class="add-cart-quick-btn"
        data-add-cart
        data-id={product.id}
        data-name={product.name}
        data-slug={product.slug}
        data-price={product.price}
        data-image={product.image}
        data-category={product.categoryName}
        title="Agregar al carrito"
        aria-label={`Agregar ${product.name} al carrito`}
      >
        <svg class="icon-outline" viewBox="0 0 24 24" width="16" height="16">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="btn-text">Agregar</span>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: all var(--transition-fast);
  }

  .product-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(34, 197, 94, 0.14);
  }

  .product-image-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 1.25rem;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    transition: transform var(--transition-normal);
  }

  .product-card:hover .product-image {
    transform: scale(1.06);
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .product-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .product-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .star-icon {
    fill: #F59E0B;
    stroke: #F59E0B;
  }

  .product-title {
    font-family: var(--font-sans);
    font-size: 0.975rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.45rem;
  }

  .product-title a {
    color: #FFFFFF;
    transition: color var(--transition-fast);
  }

  .product-title a:hover {
    color: var(--color-accent-sage);
  }

  .product-short-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin-bottom: 1.1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-bottom {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-light);
  }

  .product-pricing {
    display: flex;
    flex-direction: column;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }

  .product-original-price {
    font-size: 0.8rem;
    color: var(--text-subtle);
    text-decoration: line-through;
  }

  .add-cart-quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background-color: var(--bg-tertiary);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .add-cart-quick-btn:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--text-on-accent);
  }

  @media (max-width: 640px) {
    .product-image-wrap {
      padding: 0.65rem;
    }
    .product-info {
      padding: 0.75rem;
    }
    .product-title {
      font-size: 0.85rem;
      line-height: 1.25;
      margin-bottom: 0.3rem;
    }
    .product-category {
      font-size: 0.65rem;
    }
    .product-price {
      font-size: 0.95rem;
    }
    .product-short-desc {
      display: none;
    }
    .product-bottom {
      padding-top: 0.5rem;
    }
    .add-cart-quick-btn .btn-text {
      display: none;
    }
    .add-cart-quick-btn {
      padding: 0.4rem;
      min-width: 32px;
      height: 32px;
      justify-content: center;
    }
  }
</style>
