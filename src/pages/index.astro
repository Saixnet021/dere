---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { STORE_CONFIG, formatPrice } from '../config';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

const featuredProducts = products.filter(p => p.featured);

const cosmicHeroSlides = [
  {
    id: 1,
    title: 'Bongs de Borosilicato de Grado Intergaláctico',
    desc: 'Vidrio borosilicato 3.3 de 5mm de grosor con atrapa-hielo y percolación Honeycomb. Caladas frescas de otra galaxia sin impurezas.',
    priceVal: 'S/ 65.00',
    btnLink: '/productos?categoria=bongs',
    btnText: 'Explorar Bongs Cósmicos',
    image: '/images/alien-cosmic-hero.jpg',
    alt: 'Marcianito 420 fumando bong cósmico en el espacio'
  },
  {
    id: 2,
    title: 'Vaporizadores Herbales por Convección Pura',
    desc: 'Saborea 100% de los terpenos naturales sin combustión. Tecnología de precisión OLED para volar al espacio con cada sesión.',
    priceVal: 'S/ 290.00',
    btnLink: '/productos?categoria=vapes',
    btnText: 'Ver Vaporizadores',
    image: '/images/alien-vape-slide.jpg',
    alt: 'Alien 420 vaporizando en la cabina espacial'
  },
  {
    id: 3,
    title: 'Papelillos Raw Black & Conos Pre-Rolados',
    desc: 'El papel de liar más fino del cosmos con doble prensado y combustión ultra lenta. Fibras 100% orgánicas para viajes sin turbulencias.',
    priceVal: 'S/ 8.00',
    btnLink: '/productos?categoria=rolling-papers',
    btnText: 'Ver Papelillos & Sedas',
    image: '/images/alien-cosmic-papers.jpg',
    alt: 'Aliens 420 enrolando papeles espaciales'
  },
  {
    id: 4,
    title: 'Grinders CNC de Aluminio Aeroespacial 63mm',
    desc: 'Mecanizados en un solo bloque con dientes curvados tipo diamante, malla tamizadora de acero inoxidable y raspador de kief cósmico.',
    priceVal: 'S/ 26.00',
    btnLink: '/productos?categoria=accesorios',
    btnText: 'Ver Grinders & Bandejas',
    image: '/images/products/grinder-aluminio-63mm.jpg',
    alt: 'Grinder de aluminio aeroespacial 63mm'
  }
];

const categoriesList = [
  { id: 'bongs', name: 'Bongs & Percoladores', desc: 'Borosilicato 5mm y atrapa-hielo', count: 3 },
  { id: 'vapes', name: 'Vaporizadores Herbales', desc: 'Convección pura y extractores manuales', count: 2 },
  { id: 'pipas', name: 'Pipas & Bubblers', desc: 'Vidrio soplado, madera y metal', count: 3 },
  { id: 'rolling-papers', name: 'Rolling Papers & Sedas', desc: 'Raw, Elements y conos pre-rolados', count: 3 },
  { id: 'filtros', name: 'Filtros & Boquillas', desc: 'Carbón vegetal activo y vidrio Roor', count: 3 },
  { id: 'encendedores', name: 'Sopletes & Mecheros', desc: 'Llama jet y mecha de cáñamo', count: 3 },
  { id: 'accesorios', name: 'Grinders & Bandejas', desc: 'Aluminio CNC 6061 y frascos UV', count: 4 }
];
---

<Layout title="Artículos para Hierbas | Smoke Shop 420 Perú">
  <!-- GRAN CARRUSEL HERO CÓSMICO ESPACIAL 420 (SIN BADGES, CON FONDO MEJORADO) -->
  <section class="cosmic-hero-section" aria-label="Novedades y Colecciones Espaciales 420">
    <div class="carousel-wrapper">
      <div id="hero-slider" class="hero-slider">
        {cosmicHeroSlides.map((slide, index) => (
          <div 
            class:list={['hero-slide', { active: index === 0 }]}
            data-slide-index={index}
          >
            <div class="container slide-grid">
              <!-- Columna de Texto -->
              <div class="slide-content">
                <h1 class="slide-title">{slide.title}</h1>
                <p class="slide-description">{slide.desc}</p>

                <div class="slide-action-row">
                  <div class="slide-price-pill">
                    <span class="price-label">DESDE</span>
                    <span class="price-val">{slide.priceVal}</span>
                  </div>
                  <a href={slide.btnLink} class="btn btn-primary btn-lg">
                    <span>{slide.btnText}</span>
                    <svg class="icon-outline" viewBox="0 0 24 24" width="18" height="18">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>

                <div class="slide-perks-row">
                  <span class="slide-perk">
                    <svg class="icon-outline" viewBox="0 0 24 24" width="15" height="15">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Empaque 100% Discreto
                  </span>
                  <span class="slide-perk">
                    <svg class="icon-outline" viewBox="0 0 24 24" width="15" height="15">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Envíos a todo el Perú
                  </span>
                  <span class="slide-perk">
                    <svg class="icon-outline" viewBox="0 0 24 24" width="15" height="15">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Pedidos por WhatsApp
                  </span>
                </div>
              </div>

              <!-- Columna Visual del Producto / Marcianito -->
              <div class="slide-media">
                <div class="cosmic-image-frame">
                  <img 
                    src={slide.image} 
                    alt={slide.alt} 
                    class="cosmic-img" 
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    width="620"
                    height="420"
                    onerror="this.src='/images/hero-banner.jpg'"
                  />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Flechas de Control -->
      <button id="slider-prev-btn" class="slider-arrow prev-arrow" aria-label="Anterior slide">
        <svg class="icon-outline" viewBox="0 0 24 24" width="22" height="22">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button id="slider-next-btn" class="slider-arrow next-arrow" aria-label="Siguiente slide">
        <svg class="icon-outline" viewBox="0 0 24 24" width="22" height="22">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Paginación por Puntos -->
      <div class="slider-dots-container">
        {cosmicHeroSlides.map((_, i) => (
          <button 
            class:list={['slider-dot-btn', { active: i === 0 }]} 
            data-dot-index={i} 
            aria-label={`Slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- Categorías de Productos 420 -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">Categorías de Parafernalia 420</h2>
        <p class="section-subtitle">Encuentra piezas originales de las mejores marcas para cada estilo de consumo.</p>
      </div>

      <div class="categories-grid">
        {categoriesList.map((cat) => (
          <a href={`/productos?categoria=${cat.id}`} class="category-card">
            <div class="category-header">
              <span class="cat-count-text">{cat.count} modelos</span>
              <svg class="icon-outline cat-arrow" viewBox="0 0 24 24" width="16" height="16">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
            <h3 class="category-name">{cat.name}</h3>
            <p class="category-desc">{cat.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Productos Destacados 420 -->
  <section class="section featured-section">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <h2 class="section-title text-left">Parafernalia Destacada en Perú</h2>
          <p class="section-subtitle text-left">Las piezas más pedidas por la comunidad 420 en todo el país.</p>
        </div>
        <a href="/productos" class="btn btn-outline btn-sm">
          <span>Ver catálogo ({products.length})</span>
          <svg class="icon-outline" viewBox="0 0 24 24" width="16" height="16">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="products-grid">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Banner de Asesoría Directa por WhatsApp en Perú -->
  <section class="section cta-whatsapp-section">
    <div class="container">
      <div class="cta-box">
        <h2 class="cta-title">¿Listo para armar tu setup ideal?</h2>
        <p class="cta-desc">
          Te asesoramos de forma personalizada sobre bongs, vaporizadores, juntas y papelillos. Envíos 100% discretos a Lima y provincias del Perú.
        </p>
        <div class="cta-actions">
          <a 
            href={`https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${encodeURIComponent('¡Hola! Me gustaría recibir asesoría sobre su catálogo de bongs y vaporizadores en Perú.')}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-primary btn-lg"
          >
            <WhatsAppIcon size={20} fill="#052010" />
            <span>Chatear al WhatsApp (+{STORE_CONFIG.whatsappNumber})</span>
          </a>
          <a href="/productos" class="btn btn-secondary btn-lg">
            Explorar Todo el Catálogo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Proceso de Compra en 3 Pasos -->
  <section class="section how-it-works-section">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">Compra Rápida y Segura</h2>
        <p class="section-subtitle">Sin registros engorrosos ni contraseñas. Compra directa en 3 pasos.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <h3 class="step-title">Elige tus Piezas</h3>
          <p class="step-text">Explora nuestro catálogo 420 y agrega a tu carrito bongs, pipas, vaporizadores o sedas.</p>
        </div>

        <div class="step-card">
          <div class="step-number">02</div>
          <h3 class="step-title">Datos de Entrega</h3>
          <p class="step-text">Ingresa tu dirección de entrega en Lima o provincias en el formulario de checkout simplificado.</p>
        </div>

        <div class="step-card">
          <div class="step-number">03</div>
          <h3 class="step-title">Coordinación WhatsApp</h3>
          <p class="step-text">Envía tu orden por WhatsApp para confirmar stock, pagar por Yape, Plin o transferencia y recibir con empaque discreto.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==========================================================================
     GRAN CARRUSEL HERO CÓSMICO ESPACIAL 420
     ========================================================================== */
  .cosmic-hero-section {
    position: relative;
    background-color: #070B08;
    background-image: url('/images/hero-cosmic-bg.svg');
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    min-height: 580px;
    z-index: 2;
  }

  .hero-slider {
    width: 100%;
    position: relative;
  }

  .hero-slide {
    display: none;
    width: 100%;
    padding: 4.5rem 0 5.5rem 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .hero-slide.active {
    display: block;
    opacity: 1;
  }

  .slide-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  .slide-content {
    display: flex;
    flex-direction: column;
    z-index: 3;
  }

  .slide-title {
    font-family: var(--font-sans);
    font-size: 2.85rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .slide-description {
    font-size: 1.075rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 560px;
  }

  .slide-action-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .slide-price-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.4rem;
    background-color: rgba(15, 22, 17, 0.95);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  .price-label {
    font-size: 0.725rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 700;
  }

  .price-val {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-accent);
  }

  .slide-perks-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    flex-wrap: wrap;
  }

  .slide-perk {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .slide-perk svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Marco Visual de Imagen Cósmica */
  .slide-media {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cosmic-image-frame {
    width: 100%;
    max-width: 530px;
    aspect-ratio: 16 / 10;
    background-color: #0F1611;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.85), 0 0 28px rgba(34, 197, 94, 0.2);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .cosmic-image-frame:hover {
    border-color: var(--color-accent);
    transform: scale(1.02);
  }

  .cosmic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Flechas de Navegación */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: var(--radius-pill);
    background-color: rgba(15, 22, 17, 0.9);
    border: 1px solid var(--border-color);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all var(--transition-fast);
    backdrop-filter: blur(8px);
  }

  .slider-arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: #19241C;
    transform: translateY(-50%) scale(1.08);
  }

  .prev-arrow { left: 1.5rem; }
  .next-arrow { right: 1.5rem; }

  /* Paginación por Puntos */
  .slider-dots-container {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 10;
  }

  .slider-dot-btn {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background-color: var(--border-dark);
    border: none;
    transition: all var(--transition-fast);
  }

  .slider-dot-btn.active {
    width: 32px;
    background-color: var(--color-accent);
  }

  /* Secciones */
  .section {
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .text-left { text-align: left; }

  .section-header-flex {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Categorías */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .category-card {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem;
    transition: all var(--transition-fast);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
  }

  .category-card:hover {
    border-color: var(--color-accent);
    background-color: var(--bg-secondary);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(34, 197, 94, 0.16);
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .cat-icon-badge {
    font-size: 1.4rem;
  }

  .cat-count-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .category-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .category-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* CTA WhatsApp */
  .cta-box {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3.5rem 2.5rem;
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    backdrop-filter: blur(10px);
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 2rem auto;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Pasos de compra */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .step-card {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.25rem 2rem;
    position: relative;
    transition: border-color var(--transition-fast);
    backdrop-filter: blur(10px);
  }

  .step-card:hover {
    border-color: var(--color-accent);
  }

  .step-number {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .step-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .step-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 992px) {
    .slide-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .slider-arrow {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .carousel-wrapper {
      min-height: auto;
    }
    .hero-slide {
      padding: 1.75rem 0 2.5rem 0;
    }
    .slide-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .slide-title {
      font-size: 1.75rem;
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }
    .slide-description {
      font-size: 0.925rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .slide-action-row {
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .slide-price-pill {
      padding: 0.5rem 1rem;
    }
    .price-val {
      font-size: 1.15rem;
    }
    .slide-perks-row {
      gap: 0.75rem;
      padding-top: 1rem;
    }
    .slide-perk {
      font-size: 0.775rem;
    }
    .cosmic-image-frame {
      max-width: 100%;
      aspect-ratio: 16 / 10;
      border-radius: var(--radius-md);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.7);
    }
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }
    .category-card {
      padding: 1rem;
    }
    .category-name {
      font-size: 0.95rem;
    }
    .category-desc {
      font-size: 0.75rem;
      display: none;
    }
  }

  @media (max-width: 480px) {
    .slide-title {
      font-size: 1.5rem;
    }
    .btn-lg {
      padding: 0.7rem 1.25rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Control Interactivo del Gran Carrusel Hero Cósmico
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slider-dot-btn');
  const prevBtn = document.getElementById('slider-prev-btn');
  const nextBtn = document.getElementById('slider-next-btn');

  let currentSlide = 0;
  const totalSlides = slides.length;
  let autoPlayTimer: any = null;

  const showSlide = (index: number) => {
    currentSlide = (index + totalSlides) % totalSlides;
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === currentSlide);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === currentSlide);
    });
  };

  const nextSlide = () => showSlide(currentSlide + 1);
  const prevSlide = () => showSlide(currentSlide - 1);

  prevBtn?.addEventListener('click', () => {
    prevSlide();
    resetAutoPlay();
  });

  nextBtn?.addEventListener('click', () => {
    nextSlide();
    resetAutoPlay();
  });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      showSlide(i);
      resetAutoPlay();
    });
  });

  const startAutoPlay = () => {
    autoPlayTimer = setInterval(nextSlide, 5000);
  };

  const resetAutoPlay = () => {
    clearInterval(autoPlayTimer);
    startAutoPlay();
  };

  const sliderWrap = document.querySelector('.cosmic-hero-section');
  sliderWrap?.addEventListener('mouseenter', () => clearInterval(autoPlayTimer));
  sliderWrap?.addEventListener('mouseleave', () => startAutoPlay());

  startAutoPlay();
</script>
