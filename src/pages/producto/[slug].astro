---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import { STORE_CONFIG, formatPrice } from '../../config';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

// Related products
const relatedProducts = products
  .filter((p) => p.id !== product.id && (p.category === product.category || p.featured))
  .slice(0, 4);

const discountPercent = product.originalPrice 
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;

// WhatsApp direct order message for this specific product
const singleItemWaMessage = encodeURIComponent(
  `¡Hola! Estoy interesado en comprar el siguiente producto en Artículos para Hierbas:\n\n` +
  `🌿 *${product.name}*\n` +
  `💰 *Precio:* ${formatPrice(product.price)}\n` +
  `🔗 *Enlace:* http://localhost:4321/producto/${product.slug}\n\n` +
  `¿Tienen disponibilidad para envío inmediato?`
);

const whatsappDirectUrl = `https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${singleItemWaMessage}`;
---

<Layout 
  title={`${product.name} | Artículos para Hierbas`}
  description={product.shortDescription || product.description}
  image={product.image}
>
  <div class="product-detail-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Navegación de ruta">
        <a href="/">Inicio</a>
        <span class="sep">/</span>
        <a href="/productos">Catálogo</a>
        <span class="sep">/</span>
        <a href={`/productos?categoria=${product.category}`}>{product.categoryName}</a>
        <span class="sep">/</span>
        <span class="current">{product.name}</span>
      </nav>

      <!-- Ficha de Producto -->
      <div class="product-main-grid">
        <!-- Columna Izquierda: Galería / Imagen -->
        <div class="product-gallery">
          <div class="main-image-card">
            <img 
              src={product.image} 
              alt={product.name} 
              class="main-product-image" 
              id="main-product-img"
              loading="eager"
              decoding="async"
              onerror="this.src='/images/hero-banner.jpg'"
            />
          </div>

          <div class="trust-pill-row">
            <div class="trust-pill">
              <svg class="icon-outline" viewBox="0 0 24 24" width="16" height="16">
                <rect x="1" y="3" width="15" height="13" rx="2"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Empaque Neutro y Discreto en Perú</span>
            </div>
            <div class="trust-pill">
              <svg class="icon-outline" viewBox="0 0 24 24" width="16" height="16">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <span>Calidad 420 Garantizada</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Información y Compra -->
        <div class="product-summary">
          <div class="summary-top">
            <span class="product-category-tag">{product.categoryName}</span>
            <span class="stock-status">
              <span class="stock-dot"></span>
              En Stock — Envío Inmediato
            </span>
          </div>

          <h1 class="product-detail-title">{product.name}</h1>

          <!-- Calificación -->
          {product.rating && (
            <div class="rating-row">
              <div class="stars">
                {'★'.repeat(Math.floor(product.rating))}
              </div>
              <span class="rating-val">{product.rating.toFixed(1)}</span>
              <span class="rating-reviews">({product.reviewsCount} opiniones verificadas en Perú)</span>
            </div>
          )}

          <!-- Precios -->
          <div class="pricing-box">
            <span class="price-current">{formatPrice(product.price)}</span>
            {product.originalPrice && (
              <span class="price-old">{formatPrice(product.originalPrice)}</span>
            )}
          </div>

          <!-- Descripción -->
          <div class="description-box">
            <p class="description-text">{product.description}</p>
          </div>

          <!-- Selector de Cantidad y Botones de Compra -->
          <div class="purchase-actions-box">
            <div class="quantity-selector-wrap">
              <label for={`qty-input-${product.id}`} class="qty-label">Cantidad:</label>
              <div class="qty-control">
                <button type="button" class="qty-step-btn" id="btn-qty-minus" aria-label="Disminuir cantidad">−</button>
                <input 
                  type="number" 
                  id={`qty-input-${product.id}`} 
                  value="1" 
                  min="1" 
                  max="50" 
                  class="qty-input" 
                  aria-label="Cantidad seleccionada"
                />
                <button type="button" class="qty-step-btn" id="btn-qty-plus" aria-label="Aumentar cantidad">+</button>
              </div>
            </div>

            <div class="action-buttons-stack">
              <!-- Botón Principal: Agregar al Carrito -->
              <button 
                class="btn btn-primary btn-lg btn-block"
                data-add-cart
                data-id={product.id}
                data-name={product.name}
                data-slug={product.slug}
                data-price={product.price}
                data-image={product.image}
                data-category={product.categoryName}
              >
                <svg class="icon-outline" viewBox="0 0 24 24" width="20" height="20">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Agregar al Carrito</span>
              </button>

              <!-- Botón Secundario: WhatsApp Directo -->
              <a 
                href={whatsappDirectUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-outline btn-block"
              >
                <svg class="icon-outline" viewBox="0 0 24 24" width="20" height="20">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                <span>Preguntar o Comprar por WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Beneficios de Compra -->
          <div class="perks-list">
            <div class="perk-item">
              <svg class="icon-outline perk-icon" viewBox="0 0 24 24" width="18" height="18">
                <rect x="1" y="3" width="15" height="13" rx="2"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Envío Gratis en pedidos mayores a {formatPrice(STORE_CONFIG.freeShippingThreshold)}</span>
            </div>
            <div class="perk-item">
              <svg class="icon-outline perk-icon" viewBox="0 0 24 24" width="18" height="18">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Máxima privacidad: Sin etiquetas que revelen el contenido</span>
            </div>
            <div class="perk-item">
              <svg class="icon-outline perk-icon" viewBox="0 0 24 24" width="18" height="18">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Soporte posventa y asesoría técnica personalizada</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Ficha Técnica y Especificaciones -->
      {product.specs && (
        <section class="specs-section">
          <h2 class="specs-heading">Especificaciones Técnicas</h2>
          <div class="specs-table-wrap">
            <table class="specs-table">
              <tbody>
                {Object.entries(product.specs).map(([key, value]) => (
                  <tr>
                    <th class="spec-label">{key}</th>
                    <td class="spec-val">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Productos Relacionados -->
      {relatedProducts.length > 0 && (
        <section class="related-section">
          <div class="section-title-wrap">
            <span class="section-eyebrow">COMPLEMENTA TU EXPERIENCIA</span>
            <h2 class="section-title">Productos Relacionados</h2>
          </div>
          <div class="products-grid">
            {relatedProducts.map((relProduct) => (
              <ProductCard product={relProduct} />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<style>
  .product-detail-page {
    padding: 2.5rem 0 5rem 0;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .breadcrumbs .sep {
    color: var(--border-color);
  }

  .breadcrumbs .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Grid Principal */
  .product-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  /* Galería */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .main-image-card {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    aspect-ratio: 1 / 1;
    padding: 3rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-main-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.75rem;
  }

  .badge-discount-main {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: #FEF2F2;
    border-color: #FECACA;
    color: #DC2626;
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.75rem;
  }

  .main-product-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .trust-pill-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .trust-pill {
    flex: 1;
    min-width: 160px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-secondary);
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-pill);
  }

  .trust-pill svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Resumen e Información */
  .product-summary {
    display: flex;
    flex-direction: column;
  }

  .summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .product-category-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .stock-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: #059669;
  }

  .stock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
  }

  .product-detail-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .stars {
    color: #F59E0B;
    letter-spacing: 2px;
  }

  .rating-val {
    font-weight: 700;
    color: var(--text-primary);
  }

  .rating-reviews {
    color: var(--text-muted);
  }

  /* Precios */
  .pricing-box {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .price-current {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .price-old {
    font-size: 1.1rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .savings-tag {
    font-size: 0.775rem;
    font-weight: 700;
    color: #059669;
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .description-box {
    margin-bottom: 2rem;
  }

  .description-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Acciones de compra */
  .purchase-actions-box {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .quantity-selector-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .qty-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-pill);
    background-color: #FFFFFF;
    overflow: hidden;
  }

  .qty-step-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .qty-step-btn:hover {
    background-color: var(--bg-tertiary);
  }

  .qty-input {
    width: 44px;
    height: 36px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 700;
    border: none;
    background: transparent;
    color: var(--text-primary);
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .action-buttons-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Perks */
  .perks-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .perk-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Especificaciones */
  .specs-section {
    border-top: 1px solid var(--border-color);
    padding: 3rem 0;
    margin-bottom: 3rem;
  }

  .specs-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .specs-table-wrap {
    max-width: 700px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-subtle);
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .specs-table tr {
    border-bottom: 1px solid var(--border-light);
  }

  .specs-table tr:last-child {
    border-bottom: none;
  }

  .spec-label {
    text-align: left;
    padding: 0.85rem 1.25rem;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: 700;
    width: 35%;
    border-right: 1px solid var(--border-light);
  }

  .spec-val {
    padding: 0.85rem 1.25rem;
    color: var(--text-secondary);
    background-color: var(--bg-subtle);
  }

  /* Relacionados */
  .related-section {
    border-top: 1px solid var(--border-color);
    padding-top: 4rem;
  }

  @media (max-width: 992px) {
    .product-main-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

<script>
  // Stepper de cantidad para la página de detalle
  const minusBtn = document.getElementById('btn-qty-minus');
  const plusBtn = document.getElementById('btn-qty-plus');
  const qtyInput = document.querySelector('.qty-input') as HTMLInputElement;

  minusBtn?.addEventListener('click', () => {
    if (qtyInput) {
      const val = parseInt(qtyInput.value, 10) || 1;
      if (val > 1) qtyInput.value = (val - 1).toString();
    }
  });

  plusBtn?.addEventListener('click', () => {
    if (qtyInput) {
      const val = parseInt(qtyInput.value, 10) || 1;
      if (val < 50) qtyInput.value = (val + 1).toString();
    }
  });
</script>
